(data_only_dirs
 goblint.2026-02-12_16-35-44.files
 mopsa.2026-02-10_20-41-53.files)

(rule
 (alias runtest)
 (deps
  (sandbox always)
  (:mopsa mopsa.2026-02-10_20-41-53.files/SV-COMP26_no-overflow/AdditionIntMin.yml/checks.json)
  (:goblint goblint.2026-02-12_16-35-44.files/SV-COMP26_no-overflow/AdditionIntMin.yml/checks.json))
 (action
  (progn
   (with-stdout-to comparison.json
    (ignore-stderr
     (run ovd compare --format json --filter-category "Signed integer overflow in arithmetic operator" --filter-category "Unsigned integer overflow in arithmetic operator" --filter-path /home/holterka/sv-benchmarks/c/** %{mopsa} %{goblint})))
   (diff? AdditionIntMin.yml.comparison.json comparison.json))))

