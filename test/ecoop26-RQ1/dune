(rule
 (alias runtest)
 (deps
  (sandbox always)
  (glob_files *.comparison.json))
 (action
  (progn
   (with-stdout-to tmp.json
    (run ovd summarize *.comparison.json))
   (diff? summary.json tmp.json))))
